# ── Database ────────────────────────────────────────────────
# Inside Docker Compose the app talks to the "db" service.
DATABASE_URL="postgresql://ledgerly:ledgerly@db:5432/ledgerly?schema=public"
# If you run `npm run dev` on your host instead, use the mapped port:
# DATABASE_URL="postgresql://ledgerly:ledgerly@localhost:5433/ledgerly?schema=public"

# ── AI assistant ────────────────────────────────────────────
# ollama | anthropic | openai | none
AI_PROVIDER="ollama"

# Local model (default). Inside Compose use http://ollama:11434
OLLAMA_URL="http://ollama:11434"
OLLAMA_MODEL="qwen2.5:7b-instruct"

# Optional cloud providers — the assistant is provider-agnostic.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Seed demo data on first container start
SEED_ON_START="true"
